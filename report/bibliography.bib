@article{chen_algorithm_2008,
	title = {Algorithm 887: {CHOLMOD}, Supernodal Sparse Cholesky Factorization and Update/Downdate},
	volume = {35},
	issn = {0098-3500, 1557-7295},
	url = {https://dl.acm.org/doi/10.1145/1391989.1391995},
	doi = {10.1145/1391989.1391995},
	shorttitle = {Algorithm 887},
	abstract = {{CHOLMOD} is a set of routines for factorizing sparse symmetric positive definite matrices of the form
              A
              or
              {AA}
              T
              , updating/downdating a sparse Cholesky factorization, solving linear systems, updating/downdating the solution to the triangular system
              Lx
               = 
              b
              , and many other sparse matrix functions for both symmetric and unsymmetric matrices. Its supernodal Cholesky factorization relies on {LAPACK} and the Level-3 {BLAS}, and obtains a substantial fraction of the peak performance of the {BLAS}. Both real and complex matrices are supported. {CHOLMOD} is written in {ANSI}/{ISO} C, with both C and {MATLAB}
              {TM}
              interfaces. It appears in {MATLAB} 7.2 as x = A{\textbackslash}b when A is sparse symmetric positive definite, as well as in several other sparse matrix functions.},
	pages = {1--14},
	number = {3},
	journaltitle = {{ACM} Transactions on Mathematical Software},
	shortjournal = {{ACM} Trans. Math. Softw.},
	author = {Chen, Yanqing and Davis, Timothy A. and Hager, William W. and Rajamanickam, Sivasankaran},
	urldate = {2026-05-15},
	date = {2008-10},
	langid = {english},
	file = {PDF:/home/daniele/Zotero/storage/X9DD8TKQ/Chen et al. - 2008 - Algorithm 887 CHOLMOD, Supernodal Sparse Cholesky Factorization and UpdateDowndate.pdf:application/pdf},
}

